              }
            ]
          },
          "docs": "Get subject"
        },
        {
          "info": {
            "name": "Delete subject",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://openmeter.cloud/api/v1/subjects/:subjectIdOrKey",
            "params": [
              {
                "name": "subjectIdOrKey",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete subject"
        }
      ]
    }
